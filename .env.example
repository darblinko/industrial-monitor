# Environment variables read by the industrial-monitor CLI. All are optional.
# Use with: uv run --env-file .env industrial-monitor <command>

# MQTT broker for the simulate, monitor and scan-ble commands.
MQTT_HOST=localhost
MQTT_PORT=1883
# Site segment of the topic tree plant/<site>/<machine>/...
SITE=demo

# Alarm threshold override. The default is the value calibrated in results/detection.json.
# DETECTOR_THRESHOLD=2.6

# Needed only for --model claude.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
